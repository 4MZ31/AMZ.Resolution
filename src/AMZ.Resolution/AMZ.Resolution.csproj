<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>AMZ.Resolution</AssemblyName>
    <Product>AMZ.Resolution</Product>
    <Title>AMZ.Resolution</Title>
    <!-- Only the update bridge keeps the product identity required by pre-rename clients. -->
    <Product Condition="'$(LegacyUpdateBridge)' == 'true'">ResolutionTray</Product>
    <Version>0.7.0</Version>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <DefineConstants>$(DefineConstants);PORTABLE</DefineConstants>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../AMZ.Resolution.Core/AMZ.Resolution.Core.csproj" /></ItemGroup>
  <ItemGroup><InternalsVisibleTo Include="AMZ.Resolution.UiTests" /></ItemGroup>
</Project>
